{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "outDir": "dist/cjs",
    "declarationDir": "dist/cjs",
    "verbatimModuleSyntax": false,
    "sourceMap": false,
    "inlineSources": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/vite.ts",
    "src/bin.ts"
  ]
}
